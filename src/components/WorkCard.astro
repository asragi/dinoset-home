---
import { Picture } from "astro:assets";
import { imageWidths, metaItems, type ReleasedWork } from "../lib/works";

interface Props {
  work: ReleasedWork;
  delay: number;
}

const { work, delay } = Astro.props;
const { data } = work;
const event = data.events.at(-1);
---

<article class="work-card" data-reveal data-reveal-delay={delay}>
  <div class="work-card__media">
    <Picture
      src={data.keyImage}
      formats={["avif", "webp"]}
      widths={imageWidths(data.keyImage, [320, 480, 640, 960])}
      sizes="(min-width: 64rem) 540px, (min-width: 40rem) 45vw, 100vw"
      alt={`${data.title}のキービジュアル`}
      loading="lazy"
    />
  </div>
  <div class="work-card__body">
    {event && <p class="work-card__event">{event.name}</p>}
    <h3 class="work-card__title">
      <button class="work-card__trigger" type="button" data-work-id={work.id}>
        {data.title}
      </button>
    </h3>
    <p class="work-card__catch">{data.catchcopy}</p>
    <ul class="game-meta" aria-label="ゲーム情報">
      {metaItems(data).map(({ value }) => (
        <li>{value}</li>
      ))}
    </ul>
    <span class="work-card__more js-only" aria-hidden="true">
      詳細を見る <span class="work-card__arrow">→</span>
    </span>
    <a class="work-card__external" href={data.links.gameMarket}>
      ゲームマーケットで見る
    </a>
  </div>
</article>

<style>
  .work-card__media :global(picture),
  .work-card__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .work-card__media :global(img) {
    object-fit: contain;
    transition: transform var(--duration-reveal) var(--ease-out);
  }

  .work-card__event {
    margin-bottom: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--text-caption);
  }

  .work-card__trigger {
    font-weight: inherit;
    line-height: inherit;
    text-align: start;
  }

  /* Stretch the click target over the whole row (§8.3). */
  .work-card__trigger::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--radius-m);
  }

  .work-card__trigger:focus-visible {
    outline: none;
  }

  .work-card__trigger:focus-visible::after {
    outline: var(--focus-width) solid var(--color-accent);
    outline-offset: var(--focus-offset);
  }

  .work-card__more {
    display: inline-flex;
    gap: var(--space-2xs);
    margin-top: var(--space-m);
    color: var(--color-accent);
    font-size: var(--text-caption);
    font-weight: var(--weight-ui);
  }

  .work-card__arrow {
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .work-card__external {
    position: relative;
    z-index: var(--layer-raised);
    display: table;
    margin-top: var(--space-xs);
    padding-block: var(--space-2xs);
    font-size: var(--text-caption);
  }

  .work-card__external:hover {
    text-decoration: underline;
  }

  .work-card:hover .work-card__media :global(img) {
    transform: scale(var(--hover-scale));
  }

  .work-card:hover .work-card__arrow {
    transform: translateX(var(--hover-nudge));
  }

  @media (prefers-reduced-motion: reduce) {
    .work-card:hover .work-card__media :global(img),
    .work-card:hover .work-card__arrow {
      transform: none;
    }
  }

  /* Without JS the dialog cannot open, so do not pretend the row is clickable. */
  :global(html:not(.js)) .work-card__trigger {
    cursor: auto;
  }

  :global(html:not(.js)) .work-card__trigger::after {
    display: none;
  }
</style>
