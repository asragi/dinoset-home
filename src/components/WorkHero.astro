---
import { Picture } from "astro:assets";
import {
  eventLabel,
  imageWidths,
  metaItems,
  type ReleasedWork,
} from "../lib/works";

interface Props {
  work: ReleasedWork;
}

const { work } = Astro.props;
const { data } = work;
const event = data.events.at(-1);
const hasShop = data.links.shop !== null;
---

<section id="work-hero" aria-labelledby="work-title">
  <div class="work-hero container">
    <div class="work-hero__copy">
      {event && (
        <p class="work-hero__event">
          {eventLabel(event.date)} {event.name}{" "}
          <span class="work-hero__booth">{event.booth}</span>
        </p>
      )}
      <h1 id="work-title" class="work-hero__title">
        {data.title}
      </h1>
      <p class="work-hero__catch">{data.catchcopy}</p>
      <ul class="game-meta" aria-label="ゲーム情報">
        {metaItems(data).map(({ value }) => (
          <li>{value}</li>
        ))}
      </ul>
      <div class="button-row work-hero__actions">
        {hasShop && (
          <a class="button-primary" href={data.links.shop}>
            通販で購入
          </a>
        )}
        <a
          class={hasShop ? "button-secondary" : "button-primary"}
          href={data.links.gameMarket}
        >
          ゲームマーケットで見る
        </a>
      </div>
    </div>
    <div class="work-hero__media">
      <Picture
        src={data.keyImage}
        formats={["avif", "webp"]}
        widths={imageWidths(data.keyImage)}
        sizes="(min-width: 48rem) 58vw, 100vw"
        alt={`${data.title}のキービジュアル`}
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>
</section>

<style>
  /* Same height and position as the top page hero (RENEWAL §8.2). */
  #work-hero {
    margin-top: calc(var(--header-block) * -1);
    background: var(--color-bg);
  }

  .work-hero {
    display: grid;
    align-content: center;
    align-items: center;
    gap: var(--space-l);
    min-height: 100svh;
    padding-block: calc(var(--header-block) + var(--space-l));
  }

  .work-hero__copy {
    min-width: 0;
    container-type: inline-size;
    animation: work-hero-enter var(--duration-reveal) var(--ease-out) both;
  }

  .work-hero__event {
    margin-bottom: var(--space-m);
    color: var(--color-muted);
    font-size: var(--text-caption);
  }

  .work-hero__booth {
    white-space: nowrap;
  }

  .work-hero__title {
    font-size: min(var(--text-hero), var(--hero-title-fit));
    line-break: strict;
  }

  .work-hero__catch {
    margin-block: var(--space-m);
    color: var(--color-muted);
    font-size: var(--text-lead);
    word-break: auto-phrase;
  }

  .work-hero__actions {
    margin-top: var(--space-l);
  }

  /* Key visual first on mobile; text first, then image on load (§7.5). */
  .work-hero__media {
    display: flex;
    justify-content: center;
    grid-row: 1;
    min-width: 0;
    animation: work-hero-enter var(--duration-reveal) var(--ease-out)
      var(--hero-media-delay) both;
  }

  .work-hero__media :global(img) {
    width: auto;
    max-height: var(--work-hero-art-mobile-height);
    border-radius: var(--radius-m);
  }

  @keyframes work-hero-enter {
    from {
      opacity: 0;
      transform: translateY(var(--reveal-distance));
    }
  }

  /* Mirror of the top hero: key visual on the left (7 : 5). */
  @media (min-width: 48rem) {
    .work-hero {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    }

    .work-hero__media :global(img) {
      max-height: var(--work-hero-art-height);
    }
  }
</style>
