---
import { Picture } from "astro:assets";
import SectionHeading from "./SectionHeading.astro";
import { imageWidths, type ReleasedWork } from "../lib/works";

interface Props {
  works: ReleasedWork[];
}

const { works } = Astro.props;
const STAGGER_MS = 80; // §7.5
---

{works.length > 0 && (
  <section id="other-works" class="section" aria-labelledby="other-works-title">
    <div class="container">
      <SectionHeading
        id="other-works-title"
        label="More works"
        title="ほかの作品"
      />
      <ul class="other-works">
        {works.map(({ id, data }, index) => (
          <li data-reveal data-reveal-delay={index * STAGGER_MS}>
            <a class="other-work" href={`/works/${id}/`}>
              <div class="other-work__media">
                <Picture
                  src={data.keyImage}
                  formats={["avif", "webp"]}
                  widths={imageWidths(data.keyImage, [112, 224, 336])}
                  sizes="112px"
                  alt=""
                  loading="lazy"
                />
              </div>
              <div class="other-work__body">
                <h3 class="other-work__title">{data.title}</h3>
                <p class="other-work__catch">{data.catchcopy}</p>
              </div>
            </a>
          </li>
        ))}
      </ul>
      <p class="other-works__back">
        <a href="/#works">作品一覧へ戻る</a>
      </p>
    </div>
  </section>
)}

<style>
  #other-works {
    background: var(--color-surface);
  }

  .other-works {
    display: grid;
    grid-template-columns: repeat(
      auto-fill,
      minmax(min(100%, var(--other-work-card-min)), 1fr)
    );
    gap: var(--space-m);
  }

  /* The whole card is the link (WORK-PAGES §6.7). */
  .other-work {
    display: flex;
    align-items: center;
    gap: var(--space-m);
    color: var(--color-ink);
  }

  .other-work:hover {
    color: var(--color-ink);
  }

  .other-work__media {
    flex-shrink: 0;
    width: var(--other-work-thumb-width);
    aspect-ratio: var(--work-image-ratio);
    overflow: hidden;
    background: var(--color-bg);
    border-radius: var(--radius-m);
  }

  .other-work__media :global(picture),
  .other-work__media :global(img) {
    width: 100%;
    height: 100%;
  }

  .other-work__media :global(img) {
    object-fit: contain;
    transition: transform var(--duration-reveal) var(--ease-out);
  }

  .other-work:hover .other-work__media :global(img) {
    transform: scale(var(--hover-scale));
  }

  .other-work__body {
    min-width: 0;
  }

  .other-work__title {
    font-size: var(--text-body);
  }

  .other-work:hover .other-work__title {
    color: var(--color-accent);
  }

  .other-work__catch {
    margin-top: var(--space-2xs);
    color: var(--color-muted);
    font-size: var(--text-caption);
  }

  .other-works__back {
    margin-top: var(--space-l);
    font-size: var(--text-caption);
    font-weight: var(--weight-ui);
  }

  @media (prefers-reduced-motion: reduce) {
    .other-work:hover .other-work__media :global(img) {
      transform: none;
    }
  }
</style>
