---
import type { Work } from "../lib/works";

interface Props {
  work: Work;
  delay: number;
}

const { work, delay } = Astro.props;
---

<article class="work-card" data-reveal data-reveal-delay={delay}>
  <div class="work-card__media coming-soon__media">
    <span class="badge" lang="en">
      Coming soon
    </span>
  </div>
  <div class="work-card__body">
    <h3 class="work-card__title">{work.data.title}</h3>
    <p class="work-card__catch">{work.data.catchcopy}</p>
  </div>
</article>

<style>
  .coming-soon__media {
    display: grid;
    place-items: center;
  }
</style>
