---
import SectionHeading from "./SectionHeading.astro";
---

<section id="contact" class="section" aria-labelledby="contact-title">
  <div class="container contact">
    <SectionHeading
      id="contact-title"
      label="Contact"
      title="お問い合わせ"
      lead="作品やイベントに関するご質問はこちらから。"
    />
    <div class="contact__body" data-reveal>
      <noscript>
        <p class="contact__notice">
          フォームの送信には JavaScript が必要です。
        </p>
      </noscript>
      <form id="contact-form" class="contact-form">
        <div class="contact-form__field">
          <label for="contact-name">
            お名前<span class="contact-form__required">必須</span>
          </label>
          <input
            id="contact-name"
            name="from_name"
            type="text"
            required
            maxlength="50"
            autocomplete="name"
            aria-describedby="contact-name-error"
          />
          <p class="contact-form__error" id="contact-name-error"></p>
        </div>
        <div class="contact-form__field">
          <label for="contact-email">
            メールアドレス<span class="contact-form__required">必須</span>
          </label>
          <input
            id="contact-email"
            name="email"
            type="email"
            required
            autocomplete="email"
            inputmode="email"
            aria-describedby="contact-email-error"
          />
          <p class="contact-form__error" id="contact-email-error"></p>
        </div>
        <div class="contact-form__field">
          <label for="contact-message">
            本文<span class="contact-form__required">必須</span>
          </label>
          <textarea
            id="contact-message"
            name="message"
            required
            maxlength="2000"
            rows="7"
            aria-describedby="contact-message-error"
          ></textarea>
          <p class="contact-form__error" id="contact-message-error"></p>
        </div>
        <div class="contact-form__trap" aria-hidden="true">
          <label for="contact-website">この欄は入力しないでください</label>
          <input
            id="contact-website"
            name="website"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>
        <p class="contact-form__status" role="alert"></p>
        <button
          class="button-primary contact-form__submit"
          type="submit"
          disabled
        >
          送信する
        </button>
      </form>
    </div>
  </div>
</section>

<script>
  import "../scripts/contact-form";
</script>

<style>
  #contact {
    border-top: var(--border-width) solid var(--color-line);
  }

  .contact {
    max-width: var(--form-width);
  }

  .contact__notice {
    margin-bottom: var(--space-m);
    color: var(--color-muted);
  }

  .contact-form {
    display: grid;
    gap: var(--space-m);
  }

  label {
    display: flex;
    align-items: center;
    gap: var(--space-xs);
    margin-bottom: var(--space-xs);
    font-weight: var(--weight-ui);
  }

  .contact-form__required {
    color: var(--color-muted);
    font-size: var(--text-caption);
    font-weight: var(--weight-body);
  }

  input,
  textarea {
    display: block;
    width: 100%;
    padding: var(--space-xs) var(--space-s);
    min-height: var(--target-size);
    background: var(--color-bg);
    color: var(--color-ink);
    border: var(--border-width) solid var(--color-line-strong);
    border-radius: var(--radius-s);
    transition:
      border-color var(--duration-fast) var(--ease-out),
      box-shadow var(--duration-fast) var(--ease-out);
  }

  textarea {
    min-height: var(--textarea-height);
    resize: vertical;
  }

  input:focus,
  textarea:focus {
    border-color: var(--color-accent);
    box-shadow: var(--shadow-focus);
  }

  [aria-invalid="true"] {
    border-color: var(--color-error);
  }

  .contact-form__error,
  .contact-form__status {
    color: var(--color-error);
    font-size: var(--text-caption);
  }

  .contact-form__error {
    margin-top: var(--space-2xs);
  }

  .contact-form__error:empty,
  .contact-form__status:empty {
    display: none;
  }

  .contact-form__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  .contact-form__submit {
    justify-self: start;
  }

  .contact__body :global(.contact-success) {
    padding: var(--space-l);
    background: var(--color-surface);
    border-radius: var(--radius-m);
  }
</style>
